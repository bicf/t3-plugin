<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.bicf.t3plugin</id>
    <name>T3 Code Host (Unofficial)</name>
    <vendor>bicf</vendor>
    <description><![CDATA[
        <p><b>Unofficial plugin, in active early development.</b> Expect bugs and breaking changes between versions.
        This plugin is not affiliated with or endorsed by the T3 Code project.</p>
        <p>Shows the <a href="https://t3.codes">T3 Code</a> web UI in JetBrains IDEs. Features:</p>
        <ul>
            <li>The T3 sidebar in the "T3 Code" tool window, and each conversation in an editor tab.</li>
            <li>Diffs of T3 open in the IDE editor.</li>
            <li>With a local server, file links open in the IDE editor, and the T3 terminal and Git actions use the IDE terminal and Git, when these plugins are installed.</li>
            <li>With a local server, "Ask T3 About Selection" in the editor context menu sends the selected code to T3.</li>
            <li>A status bar widget shows the state of the T3 Code server.</li>
        </ul>
        <p>Local server: the plugin connects to a running T3 Code server on this machine, or starts <code>t3 serve</code> when no server runs.
        It requires the <code>t3</code> CLI.</p>
        <p>Remote server: paste a pairing link from <code>t3 pair</code>. The plugin does not need the <code>t3</code> CLI.
        File links, the terminal and Git stay on the remote machine.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Since 2026.2 the JCEF API is provided by the bundled "Web Browser (JCEF)" plugin. -->
    <depends>com.intellij.modules.jcef</depends>
    <!-- Optional IDE tools: without these plugins, T3 keeps its own terminal and Git actions. -->
    <depends optional="true" config-file="t3-terminal.xml">org.jetbrains.plugins.terminal</depends>
    <depends optional="true" config-file="t3-git.xml">Git4Idea</depends>

    <resource-bundle>messages.T3Bundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="T3 Code"
                    anchor="left"
                    icon="/icons/toolWindow.svg"
                    factoryClass="com.bicf.t3plugin.toolWindow.T3ToolWindowFactory"/>
        <toolWindow id="T3 Workspace"
                    anchor="right"
                    icon="/icons/toolWindow.svg"
                    canCloseContents="true"
                    doNotActivateOnStart="true"
                    factoryClass="com.bicf.t3plugin.workspace.T3WorkspaceToolWindowFactory"/>
        <applicationConfigurable parentId="tools"
                                 id="com.bicf.t3plugin.settings"
                                 key="settings.displayName"
                                 instance="com.bicf.t3plugin.settings.T3Configurable"/>
        <statusBarWidgetFactory id="com.bicf.t3plugin.ServerStatus"
                                implementation="com.bicf.t3plugin.statusBar.T3StatusWidgetFactory"/>
        <notificationGroup id="T3 Code" displayType="BALLOON" key="notification.group"/>
        <fileEditorProvider implementation="com.bicf.t3plugin.editor.T3PageEditorProvider"/>
    </extensions>

    <projectListeners>
        <listener class="com.bicf.t3plugin.editor.T3PageTabs$SelectionListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <actions>
        <action id="com.bicf.t3plugin.AskAboutSelection"
                class="com.bicf.t3plugin.actions.T3AskAboutSelectionAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
